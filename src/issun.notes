C 0x8C03 2 casillas
C 0x8C06 LDIRVM
C 0x8C0A en la fila 11
C 0x8C10 LDIRVM
C 0x8C14 どんなもんだい: la fila 12, columna 12
C 0x8C17 12 casillas
C 0x8C1A LDIRVM
C 0x8C1E la fila 13
C 0x8C24 LDIRVM
L 0x8C94 presentacion_centro   Desde el paso 9: el CASIO que baja (0xE189) y el que sube (0xE18B), cada uno con una fila en blanco detras para borrar su rastro
C 0x8C94 el paso...
C 0x8C97 ...9?
L 0xB3EC canal_byte                El byte siguiente de la pieza (0xE2C3): menos de 0xF0, una nota (duracion y volumen, el tono) y 3; si no, una orden
C 0xB3F3 el byte
C 0xB3F4 0xF0 o mas: una orden
C 0xB5A3 el byte siguiente
C 0xB5A5 por debajo de 0x10?
C 0xB5A7 no: un byte
C 0xB5A9 la parte alta, al registro B + 1
C 0xB5AD la baja
L 0xB5AE nota_tono_bajo
C 0xB5AE al registro B
x8C97 ...9?
C 0x8C99 antes: nada
C 0x8C9A 8 casillas
C 0x8C9D la fila de abajo de CASIO (0x8D64)...
C 0x8CA7 una fila arriba
C 0x8CAE la de arriba (0x8D5B)
C 0x8CB4 LDIRVM
C 0x8CB7 otra fila arriba
C 0x8CBE en blanco (0x8DFE)
C 0x8CC4 LDIRVM
C 0x8CC7 el que sube: 8 casillas
C 0x8CCA la fila de arriba...
C 0x8CCD ...donde va
C 0x8CD1 LDIRVM
C 0x8CD4 una fila abajo
C 0x8CD9 la de abajo
C 0x8CDF LDIRVM
C 0x8CE2 otra fila abajo
C 0x8CE7 en blanco
L 0x9E9A jefe_choque_arma_caja
C 0x9E9B su tabla
C 0x9E9F el dibujo...
C 0x9EA2 ...x 8
L 0xB2E0 efecto_a_pide         Pide el efecto A del canal A (0xE2C0): si ya hay uno pedido, gana el de numero menor
C 0xB2E0 el efecto
C 0xB2E1 jugando? (no sirve: pide_va mira otra cosa)
C 0xB2E6 el efecto del canal A pedido
C 0xB2E9 a pedirlo
L 0xB2EB efecto_bc_pide        Pide el efecto A de los canales B y C (0xE2C2), con la misma regla
C 0xB2EB el efecto
C 0xB2EC jugando? (no sirve)
L 0xB2F4 pide_va               El pedido A en (HL), si no hay otro o el de antes es de numero mayor
C 0xB2F4 el nuevo
L 0xB317 sonido_efecto_bc
C 0xB317 nada en el canal A...
C 0xB318 ...un efecto de B y C sonando?
C 0xB31A si
C 0xB31C uno pedido?
C 0xB31E si: empieza
L 0xB321 sonido_musica_mira
C 0xB321 una musica pedida antes que la que suena?
C 0xB324 si: empieza
C 0xB327 si no, el canal A
L 0xB329 sonido_efecto_a_mira
C 0xB329 un efecto del canal A pedido antes que el que suena?
C 0xB32C si: empieza
L 0xB331 sonido_efecto_bc_mira
C 0xB331 un efecto de B y C pedido antes que el que suena?
C 0xB334 si: empieza
C 0xB349 el canal A: registros 0 y 8
C 0xB34C el canal 0
C 0xB34D un paso
C 0xB351 de vuelta al canal A
C 0xB358 sigue?
C 0xB35B 1: la musica acabada
C 0xB360 2: el efecto acabado
C 0xB376 el canal B: registros 2 y 9
C 0xB379 el mezclador...
C 0xB37C ...un bit a la derecha
C 0xB380 el canal 1
C 0xB382 un paso
C 0xB386 de vuelta al canal B
L 0xB39E sonido_canal_c        El canal C: un paso (registros 4 y 10) y el barrido del ruido
C 0xB39E el canal C
C 0xB3A1 al canal de trabajo
C 0xB3A4 registros 4 y 10
C 0xB3A7 el mezclador...
C 0xB3AA ...dos bits a la derecha
C 0xB3AF el canal 2
C 0xB3B1 un paso
C 0xB3B5 de vuelta al canal C
C 0xB3BC 3: sigue
C 0xB3BE el ruido
C 0xB3C1 los bits del mezclador...
C 0xB3C2 ...de vuelta
C 0xB3CA acabado?
C 0xB3CC si
C 0xB3CF el ruido
L 0xB4DD canal_un_paso         Un paso del canal de trabajo, que es el A (0xE2D5)
C 0xB4DD el canal
C 0xB4E0 un paso
L 0xB4E4 pedido_mira           C si lo pedido (HL + 1) va antes (numero menor) que lo que suena (HL)
C 0xB4E4 lo que suena
C 0xB4E6 lo pedido
C 0xB4E7 nada: NC
C 0xB4E9 menor: C
L 0xB4EB canal_cuenta          La cuenta de la nota: un cuadro menos; acabada, A = 1; con volumen 15 la envolvente corta, si no la que baja el volumen
C 0xB4EB la duracion...
C 0xB4EC ...un cuadro menos
C 0xB4ED acabada
C 0xB4F1 el volumen
C 0xB4F2 sin envolvente
L 0xB5A3 nota_tono             El tono de la nota: dos bytes (el alto, por debajo de 0x10, al registro B + 1) o uno (al registro B)
D 0xB5B3 0xB5C1 duraciones        Las 14 duraciones de las notas (la mitad alta del byte de la nota, 0-13)
L 0xB5D9 musica_empieza        Una musica: los tres canales de la tabla de 0xB280 (6 bytes por musica: la musica N en 0xB280 + 6N), el mezclador con los tres tonos y a sonar
C 0xB5DC la pedida...
C 0xB5DF ...suena
C 0xB5E2 x 6
C 0xB5E8 el canal A
C 0xB5EB los canales B y C
C 0xB5EF sin nota en marcha...
C 0xB5F2 ...y el pedido gastado
C 0xB5F5 los tres canales con tono, sin ruido
L 0xB5F7 mezclador_pon         El mezclador A (0xE03C) al registro 7 y al canal A
C 0xB5F7 el mezclador
C 0xB5FA al PSG
C 0xB5FD a sonar
L 0xB600 musica_acaba          La musica acabada: otra pedida, o el sonido a cero
C 0xB600 otra pedida?
C 0xB604 si: empieza
C 0xB606 ninguna suena
C 0xB609 0xFF: todo callado
L 0xB60A sonido_cero           El mezclador A y los canales (0xE280, 0x43 bytes) a cero
C 0xB60A el mezclador...
C 0xB60D ...al PSG
C 0xB610 los canales...
C 0xB613 ...0x43 bytes
L 0xB615 cero_b                B bytes de HL a cero
C 0xB615 a cero
L 0xB61B efecto_a_empieza      Un efecto del canal A (0xE2C0): su pieza de la tabla de 0xB2AA (2 bytes por efecto)
C 0xB61B la tabla de los efectos del canal A
C 0xB61E el pedido...
C 0xB621 ...suena
C 0xB624 x 2
C 0xB625 su pieza
C 0xB63A y los de B y C
L 0xB656 mezclador_guarda
C 0xB656 apuntado
C 0xB659 al PSG
L 0xB65C efecto_bc_empieza     Un efecto de los canales B y C (0xE2C2): sus dos piezas de la tabla de 0xB2C0 (4 bytes por efecto)
C 0xB65C la tabla de los efectos de B y C
C 0xB65F el pedido...
C 0xB662 ...suena
C 0xB665 x 4
C 0xB669 sus piezas
C 0xB66C el pedido, gastado
C 0xB66F el mezclador: B y C con tono
C 0xB674 al PSG
L 0xB677 sonido_bc_acaba       El efecto de B y C acabado: otro pedido, o B y C callados
C 0xB677 otro pedido?
C 0xB67B si: empieza
C 0xB67D ninguno suena
C 0xB680 los canales B y C...
C 0xB683 ...36 bytes...
C 0xB685 ...a cero
D 0xA280 0xB280 casillas_y_sprites Las casillas del segundo tercio desde la escena 3 (0xA280, 0x400 bytes) y sus colores (0xA680), y los dibujos de los 64 sprites (0xAA80, 0x800 bytes; a 0x3800)
D 0xB280 0xB2AA musicas           Las 7 musicas: las piezas de los canales A, B y C (6 bytes cada una; la 0, nada)
D 0xB2AA 0xB2C0 efectos_a         Los 11 efectos del canal A: su pieza (2 bytes; el 0, nada)
D 0xB2C0 0xB2E0 efectos_bc        Los 8 efectos de los canales B y C: sus dos piezas (4 bytes; el 0, nada)
D 0xB6BC 0xC000 piezas            Las piezas de las musicas y los efectos (los punteros de 0xB280-0xB2DF): notas, ruidos y ordenes 0xF0-0xFF
L 0x4010 init                  INIT: sin interrupciones, la pantalla apagada, el slot del cartucho tambien en la pagina 2 (ENASLT) y al codigo de 0x8000
C 0x8823 ...0x800 bytes (hasta la tabla de sprites incluida)
C 0x8BCC el final (0xE484)?
C 0x8462 ...16 mas abajo los de abajo
C 0x846A la misma X para los cuatro
C 0x8464 la del tercer sprite (0xE340)
L 0xB562 nota_pon              Una nota: la mitad alta del byte es la duracion (la tabla de 0xB5B3, o el byte siguiente con 0xE), la baja el volumen (15: la mitad)
L 0xB365 sonido_canal_b        Los canales B y C: con la musica o el efecto de B y C, un paso de cada uno (los registros 2-3 y 9, 4-5 y 10); al acabar, sonido_bc_acaba (0xB677)
D 0x4000 0x4010 cabecera           La cabecera del cartucho: "AB", INIT 0x4010, sin STATEMENT, DEVICE ni TEXT; la demostracion la lee como mandos (0xE037 = 0x4000)
D 0x4038 0x4042 tierra_planos      Los decorados de tierra de las cinco escenas: un puntero cada una (0x417C, 0x4132, 0x4066, 0x40D8 y 0x4042)
D 0x4042 0x41D6 tierra_listas      Cada decorado de tierra: rectangulos (fila, columna, ancho, alto y casilla) hasta 0xFF y dibujos (fila, columna y direccion) hasta 0xFF
D 0x41D6 0x4460 tierra_dibujos     Los dibujos de tierra (ancho, alto y casillas); el de 0x431A (8 x 1, la casilla 0x97) no lo usa ninguna lista
D 0x4460 0x4468 rio_planos         Los mapas del rio de las escenas 0-3: un puntero cada una (0x470F, 0x4468, 0x4539 y 0x4606)
D 0x4468 0x4860 rio_listas         Las listas de cada mapa del rio: fila, columna y direccion del dibujo (84, 52, 51 y 66 dibujos), hasta 0xFF
D 0x4860 0x4A1E rio_dibujos        Los dibujos del rio (ancho, alto y casillas; 0, transparente)
D 0x4A1E 0x4A32 orilla_dibujo      La orilla (2 x 9 casillas), en la fila 13 al llegar
D 0x4A32 0x4AC3 tierra_dibujos2    Mas dibujos de tierra
D 0x4AC3 0x4B80 jefe_dibujos_1     Los cinco dibujos del jefe de la segunda escena (0xE003 = 1) (0x4AC3, 0x4AE1, 0x4AFF, 0x4B24 y 0x4B57)
D 0x4B80 0x4D00 letras_dibujos     Las letras (casillas 0-0x2F): las cifras 0-9 y las letras desde la 0x11 (A)
D 0x4D00 0x5000 casillas_d0        Las casillas 0xD0-0xFF de la partida (0x4D00) y sus colores (0x4E80)
D 0x5000 0x5300 titulo_casillas    Las casillas del titulo (desde la 0x30: el nombre y CASIO; el final las pone en el segundo tercio para どんなもんだい)
D 0x5300 0x5800 partida_casillas   Las casillas 0x30-0xCF de la partida; las 0x90-0x9F y 0xA0-0xA7 guardan tambien los cuatro pasos del agua (0x5600, 0x5680 y 0x56C0)
D 0x5800 0x5B00 titulo_colores     Los colores de las casillas del titulo; sus ultimos 0x100 bytes (0x5A00) son a la vez los dibujos de los sprites de la pausa (por eso esos colores se pintan de blanco, 0x88CD)
D 0x5B00 0x6000 partida_colores    Los colores de las casillas 0x30-0xCF (con los del agua en 0x5E00-0x5EFF)
D 0x6000 0x8000 decorado_casillas  Las casillas del decorado: las del primer tercio (0x6000) y sus colores (0x6800), las del segundo (0x7000) y sus colores (0x7800)
L 0x8000 arranque_nop          16 "nop": INIT (0x4035) salta a 0x8000 y los recorre hasta el arranque
